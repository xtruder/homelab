CF_API_EMAIL=Cloudflare Email
CF_DNS_API_TOKEN=Cloudflare Token
DOMAIN_NAME=example.com
BROWSERBOI_TOKEN=random_token
BROWSERBOI_YOUTUBE_COOKIES=cookies_from_youtube

# LibreChat Security Settings
LIBRECHAT_JWT_SECRET=your_jwt_secret_key_here
LIBRECHAT_JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
LIBRECHAT_CREDS_KEY=your_credentials_key_here
LIBRECHAT_CREDS_IV=your_credentials_iv_here
LIBRECHAT_MEILI_MASTER_KEY=your_meilisearch_master_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Hermes Agent
HERMES_API_SERVER_KEY=generate_with_openssl_rand_hex_32
HERMES_WEBUI_PASSWORD=use_a_strong_unique_password
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=use_another_strong_unique_password
HERMES_DASHBOARD_SECRET=generate_with_openssl_rand_base64_32
HERMES_RDP_BIND_ADDRESS=100.64.0.1
HERMES_CHROME_PROXY_URL=

# Session Settings
LIBRECHAT_SESSION_EXPIRY=1000 * 60 * 15
LIBRECHAT_REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7
