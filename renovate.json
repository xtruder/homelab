{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions on jarvis, pinned below a `renovate:` comment",
      "managerFilePatterns": ["/^dotfiles/\\.chezmoiexternal\\.toml$/"],
      "matchStrings": [
        "renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[^\\n]*\\n[^\\n]*\"(?<currentValue>v?[0-9][^\"]*)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Push minor/patch compose updates straight to master; homelab-verify checks them on jarvis after deploy. Stack changes trigger no status checks, hence ignoreTests.",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": true,
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": [
        "stacks/media-stack/docker-compose.yml",
        "stacks/ollama/docker-compose.yml"
      ],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/transmission"],
      "versioning": "semver",
      "allowedVersions": ">4.0.0"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/jellyfin"],
      "versioning": "semver",
      "allowedVersions": ">10.0.0"
    }
  ]
}
