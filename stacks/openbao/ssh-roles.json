{
  "defaults": {
    "ttl": "1h",
    "extensions": ["permit-pty", "permit-port-forwarding", "permit-agent-forwarding"]
  },
  "roles": {
    "jarvis-core": {
      "principal": "core@jarvis"
    },
    "jarvis-offlinehq": {
      "principal": "offlinehq@jarvis"
    },
    "oglasnadeska-user": {
      "principal": "user@oglasnadeska"
    },
    "agentbox-agent": {
      "principal": "agent@agentbox"
    },
    "ucg-max-root": {
      "principal": "root@ucg-max"
    }
  }
}
