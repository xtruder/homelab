[Unit]
Description=Verify homelab deployment with opencode
ConditionPathExists=!%h/homelab/.working
# Holds GH_TOKEN (fine-grained PAT for xtruder/homelab)
ConditionPathExists=%h/.config/homelab-verify/env

[Service]
Type=oneshot
EnvironmentFile=%h/.config/homelab-verify/env
ExecStart=%h/.local/bin/homelab-verify
TimeoutStartSec=1h
