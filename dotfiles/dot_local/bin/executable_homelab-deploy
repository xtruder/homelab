#!/usr/bin/env bash
# Run by homelab-cron.service: deploy master, then queue homelab-verify for
# any new commits.
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
cd "$HOME/homelab" || exit 1

git pull --ff-only origin master || exit 1

# A failed dotfile apply (for example a download of an external) must not
# block stack deploys.
rc=0
chezmoi apply --force --no-tty || rc=$?
systemctl --user daemon-reload
systemctl --user reload 'docker-compose@*.service' || rc=$?

# homelab-verify decides itself whether there is anything new to verify.
systemctl --user start --no-block homelab-verify.service
exit "$rc"
